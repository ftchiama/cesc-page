| proname              | corpo                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| -------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |
| cesc_aura_distribuir | CREATE OR REPLACE FUNCTION public.cesc_aura_distribuir(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_aura_distribuir(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| cesc_aura_distribuir | CREATE OR REPLACE FUNCTION cesc.cesc_aura_distribuir(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_alocacao record;<br>    v_sala record;<br>    v_aluno record;<br>    v_inscricoes uuid[];<br>    v_idx int;<br>    v_alunos_na_sala int;<br>    v_num_seq int := 0;<br>    v_total_distribuidos int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    -- Percorrer cada regra de alocação (ex: Pav 1, Salas 1-3, 10ª CFB)<br>    FOR v_alocacao IN <br>        SELECT * FROM cesc.alocacao_salas WHERE ano_lectivo = p_ano_lectivo<br>    LOOP<br>        -- Ir buscar as inscrições aprovadas/novas do curso/classe, que ainda não têm sala<br>        SELECT array_agg(i.id ORDER BY i.nome_completo)<br>        INTO v_inscricoes<br>        FROM cesc.inscricoes i<br>        JOIN cesc.matriculas m ON m.aluno_id = i.aluno_id AND m.ano_lectivo = i.ano_lectivo<br>        WHERE i.ano_lectivo = p_ano_lectivo<br>          AND i.estado = 'matricula_paga'<br>          AND i.classe_pretendida = v_alocacao.classe<br>          AND (i.curso_pretendido = v_alocacao.curso OR v_alocacao.curso IS NULL)<br>          AND m.sala_id IS NULL;<br><br>        IF v_inscricoes IS NULL THEN CONTINUE; END IF;<br><br>        v_idx := 1;<br>        -- Percorrer as salas da alocação (ex: Salas 1, 2, 3)<br>        FOR v_sala IN <br>            SELECT s.id, s.capacidade <br>            FROM cesc.salas s<br>            WHERE s.turno = v_alocacao.turno <br>              AND s.pavilhao = v_alocacao.pavilhao<br>              AND CAST(regexp_replace(s.nome_sala, '\\D', '', 'g') AS integer) BETWEEN v_alocacao.sala_inicio AND v_alocacao.sala_fim<br>            ORDER BY s.nome_sala<br>        LOOP<br>            v_alunos_na_sala := 0;<br>            WHILE v_idx <= array_length(v_inscricoes, 1) AND v_alunos_na_sala < v_sala.capacidade LOOP<br>                -- Atribuir a sala e o número sequencial<br>                v_num_seq := v_num_seq + 1;<br>                UPDATE cesc.matriculas <br>                SET sala_id = v_sala.id, numero_aluno = v_num_seq<br>                WHERE aluno_id = (SELECT aluno_id FROM cesc.inscricoes WHERE id = v_inscricoes[v_idx])<br>                  AND ano_lectivo = p_ano_lectivo;<br><br>                v_idx := v_idx + 1;<br>                v_alunos_na_sala := v_alunos_na_sala + 1;<br>                v_total_distribuidos := v_total_distribuidos + 1;<br>            END LOOP;<br><br>            IF v_idx > array_length(v_inscricoes, 1) THEN EXIT; END IF;<br>        END LOOP;<br>    END LOOP;<br><br>    RETURN json_build_object('ok', true, 'distribuidos', v_total_distribuidos);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| cesc_aura_julgar     | CREATE OR REPLACE FUNCTION public.cesc_aura_julgar(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_aura_julgar(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| cesc_aura_julgar     | CREATE OR REPLACE FUNCTION cesc.cesc_aura_julgar(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_aluno record;<br>    v_regra record;<br>    v_neg_crit int;<br>    v_neg_sec int;<br>    v_aprovado boolean;<br>    v_qtd int := 0;<br>    v_aprovados int := 0;<br>    v_reprovados int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    FOR v_aluno IN <br>        SELECT i.id as inscricao_id, i.aluno_id, i.classe_pretendida, i.curso_pretendido<br>        FROM cesc.inscricoes i<br>        WHERE i.ano_lectivo = p_ano_lectivo AND i.estado = 'matricula_paga' <br>          AND (i.tipo IS NULL OR i.tipo = 'novo')<br>    LOOP<br>        v_qtd := v_qtd + 1;<br><br>        -- Buscar a regra da classe/curso (SEM FILTRAR POR ANO)<br>        SELECT * INTO v_regra FROM cesc.regras_aura <br>        WHERE classe = v_aluno.classe_pretendida <br>          AND (curso = v_aluno.curso_pretendido OR curso IS NULL)<br>        LIMIT 1;<br><br>        IF NOT FOUND THEN<br>            UPDATE cesc.inscricoes SET tipo = 'reprovado' WHERE id = v_aluno.inscricao_id;<br>            v_reprovados := v_reprovados + 1;<br>            CONTINUE;<br>        END IF;<br><br>        -- Contar negativas, filtrando as notas pelo ano letivo<br>        SELECT count(*) INTO v_neg_crit <br>        FROM cesc.notas_trimestrais nt <br>        JOIN cesc.matriculas m ON m.id = nt.matricula_id <br>        WHERE m.aluno_id = v_aluno.aluno_id <br>          AND m.ano_lectivo = p_ano_lectivo<br>          AND nt.mfd < 10 <br>          AND nt.disciplina IN ('Matemática', 'Biologia', 'Química', 'Física');<br>        <br>        SELECT count(*) INTO v_neg_sec <br>        FROM cesc.notas_trimestrais nt <br>        JOIN cesc.matriculas m ON m.id = nt.matricula_id <br>        WHERE m.aluno_id = v_aluno.aluno_id <br>          AND m.ano_lectivo = p_ano_lectivo<br>          AND nt.mfd < 10 <br>          AND nt.disciplina NOT IN ('Matemática', 'Biologia', 'Química', 'Física');<br><br>        v_aprovado := (v_neg_crit <= v_regra.max_negativas_criticas) AND (v_neg_sec <= v_regra.max_negativas_secundarias);<br><br>        IF v_aprovado THEN<br>            UPDATE cesc.inscricoes SET tipo = 'aprovado' WHERE id = v_aluno.inscricao_id;<br>            v_aprovados := v_aprovados + 1;<br>        ELSE<br>            UPDATE cesc.inscricoes SET tipo = 'reprovado' WHERE id = v_aluno.inscricao_id;<br>            v_reprovados := v_reprovados + 1;<br>        END IF;<br>    END LOOP;<br><br>    RETURN json_build_object('ok', true, 'total', v_qtd, 'aprovados', v_aprovados, 'reprovados', v_reprovados);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| cesc_executar_aura   | CREATE OR REPLACE FUNCTION public.cesc_executar_aura(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_executar_aura(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| cesc_executar_aura   | CREATE OR REPLACE FUNCTION cesc.cesc_executar_aura(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_aluno record;<br>    v_regra record;<br>    v_neg_crit int;<br>    v_neg_sec int;<br>    v_aprovado boolean;<br>    v_qtd_alunos int := 0;<br>    v_qtd_aprovados int := 0;<br>    v_qtd_reprovados int := 0;<br>    <br>    v_sala record;<br>    v_inscricoes_aprovadas uuid[] := ARRAY[]::uuid[];<br>    v_idx int := 1;<br>    v_total_alunos int;<br>    v_alunos_na_sala int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    -- 1. AVALIAÇÃO DOS ALUNOS (Aprova ou Reprovado)<br>    FOR v_aluno IN <br>        SELECT i.id as inscricao_id, i.aluno_id, i.classe_pretendida, i.curso_pretendido, i.nome_completo<br>        FROM cesc.inscricoes i<br>        WHERE i.ano_lectivo = p_ano_lectivo AND i.estado = 'matricula_paga'<br>        ORDER BY i.nome_completo ASC<br>    LOOP<br>        v_qtd_alunos := v_qtd_alunos + 1;<br><br>        SELECT * INTO v_regra FROM cesc.regras_aura <br>        WHERE ano_lectivo = p_ano_lectivo AND classe = v_aluno.classe_pretendida AND (curso = v_aluno.curso_pretendido OR curso IS NULL);<br><br>        IF NOT FOUND THEN<br>            UPDATE cesc.inscricoes SET motivo_rejeicao = 'Sem regra AURA', estado = 'aprovada' WHERE id = v_aluno.inscricao_id;<br>            v_qtd_reprovados := v_qtd_reprovados + 1;<br>            CONTINUE;<br>        END IF;<br><br>        SELECT count(*) INTO v_neg_crit FROM cesc.notas_trimestrais nt JOIN cesc.matriculas m ON m.id = nt.matricula_id WHERE m.aluno_id = v_aluno.aluno_id AND nt.mfd < 10 AND nt.disciplina IN ('Matemática', 'Biologia', 'Química', 'Física');<br>        SELECT count(*) INTO v_neg_sec FROM cesc.notas_trimestrais nt JOIN cesc.matriculas m ON m.id = nt.matricula_id WHERE m.aluno_id = v_aluno.aluno_id AND nt.mfd < 10 AND nt.disciplina NOT IN ('Matemática', 'Biologia', 'Química', 'Física');<br><br>        v_aprovado := (v_neg_crit <= v_regra.max_negativas_criticas) AND (v_neg_sec <= v_regra.max_negativas_secundarias);<br><br>        IF v_aprovado THEN<br>            v_qtd_aprovados := v_qtd_aprovados + 1;<br>            UPDATE cesc.inscricoes SET estado = 'matriculado' WHERE id = v_aluno.inscricao_id;<br>            v_inscricoes_aprovadas := array_append(v_inscricoes_aprovadas, v_aluno.inscricao_id);<br>        ELSE<br>            v_qtd_reprovados := v_qtd_reprovados + 1;<br>            UPDATE cesc.inscricoes SET motivo_rejeicao = 'Reprovado pela AURA', estado = 'aprovada' WHERE id = v_aluno.inscricao_id;<br>        END IF;<br>    END LOOP;<br><br>    -- 2. DISTRIBUIÇÃO DOS APROVADOS PELAS SALAS REAIS<br>    IF array_length(v_inscricoes_aprovadas, 1) IS NULL OR array_length(v_inscricoes_aprovadas, 1) = 0 THEN<br>        RETURN json_build_object('ok', true, 'total_processados', v_qtd_alunos, 'aprovados', v_qtd_aprovados, 'reprovados', v_qtd_reprovados, 'mensagem', 'Nenhum aluno aprovado para distribuir.');<br>    END IF;<br><br>    v_total_alunos := array_length(v_inscricoes_aprovadas, 1);<br>    v_alunos_na_sala := 0;<br>    v_idx := 1;<br><br>    FOR v_sala IN <br>        SELECT id, nome_sala, pavilhao, turno, capacidade FROM cesc.salas ORDER BY turno, pavilhao, nome_sala<br>    LOOP<br>        WHILE v_idx <= v_total_alunos AND v_alunos_na_sala < v_sala.capacidade LOOP<br>            UPDATE cesc.matriculas <br>            SET sala_id = v_sala.id <br>            WHERE aluno_id = (SELECT aluno_id FROM cesc.inscricoes WHERE id = v_inscricoes_aprovadas[v_idx])<br>              AND ano_lectivo = p_ano_lectivo;<br><br>            v_idx := v_idx + 1;<br>            v_alunos_na_sala := v_alunos_na_sala + 1;<br>        END LOOP;<br><br>        IF v_idx > v_total_alunos THEN EXIT; END IF;<br>        v_alunos_na_sala := 0;<br>    END LOOP;<br><br>    RETURN json_build_object(<br>        'ok', true, <br>        'total_processados', v_qtd_alunos,<br>        'aprovados', v_qtd_aprovados,<br>        'reprovados', v_qtd_reprovados,<br>        'mensagem', 'Distribuição concluída com sucesso.'<br>    );<br>END;<br>$function$<br> || proname              | corpo                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   |
| -------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |
| cesc_aura_distribuir | CREATE OR REPLACE FUNCTION public.cesc_aura_distribuir(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_aura_distribuir(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |
| cesc_aura_distribuir | CREATE OR REPLACE FUNCTION cesc.cesc_aura_distribuir(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_alocacao record;<br>    v_sala record;<br>    v_aluno record;<br>    v_inscricoes uuid[];<br>    v_idx int;<br>    v_alunos_na_sala int;<br>    v_num_seq int := 0;<br>    v_total_distribuidos int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    -- Percorrer cada regra de alocação (ex: Pav 1, Salas 1-3, 10ª CFB)<br>    FOR v_alocacao IN <br>        SELECT * FROM cesc.alocacao_salas WHERE ano_lectivo = p_ano_lectivo<br>    LOOP<br>        -- Ir buscar as inscrições aprovadas/novas do curso/classe, que ainda não têm sala<br>        SELECT array_agg(i.id ORDER BY i.nome_completo)<br>        INTO v_inscricoes<br>        FROM cesc.inscricoes i<br>        JOIN cesc.matriculas m ON m.aluno_id = i.aluno_id AND m.ano_lectivo = i.ano_lectivo<br>        WHERE i.ano_lectivo = p_ano_lectivo<br>          AND i.estado = 'matricula_paga'<br>          AND i.classe_pretendida = v_alocacao.classe<br>          AND (i.curso_pretendido = v_alocacao.curso OR v_alocacao.curso IS NULL)<br>          AND m.sala_id IS NULL;<br><br>        IF v_inscricoes IS NULL THEN CONTINUE; END IF;<br><br>        v_idx := 1;<br>        -- Percorrer as salas da alocação (ex: Salas 1, 2, 3)<br>        FOR v_sala IN <br>            SELECT s.id, s.capacidade <br>            FROM cesc.salas s<br>            WHERE s.turno = v_alocacao.turno <br>              AND s.pavilhao = v_alocacao.pavilhao<br>              AND CAST(regexp_replace(s.nome_sala, '\\D', '', 'g') AS integer) BETWEEN v_alocacao.sala_inicio AND v_alocacao.sala_fim<br>            ORDER BY s.nome_sala<br>        LOOP<br>            v_alunos_na_sala := 0;<br>            WHILE v_idx <= array_length(v_inscricoes, 1) AND v_alunos_na_sala < v_sala.capacidade LOOP<br>                -- Atribuir a sala e o número sequencial<br>                v_num_seq := v_num_seq + 1;<br>                UPDATE cesc.matriculas <br>                SET sala_id = v_sala.id, numero_aluno = v_num_seq<br>                WHERE aluno_id = (SELECT aluno_id FROM cesc.inscricoes WHERE id = v_inscricoes[v_idx])<br>                  AND ano_lectivo = p_ano_lectivo;<br><br>                v_idx := v_idx + 1;<br>                v_alunos_na_sala := v_alunos_na_sala + 1;<br>                v_total_distribuidos := v_total_distribuidos + 1;<br>            END LOOP;<br><br>            IF v_idx > array_length(v_inscricoes, 1) THEN EXIT; END IF;<br>        END LOOP;<br>    END LOOP;<br><br>    RETURN json_build_object('ok', true, 'distribuidos', v_total_distribuidos);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| cesc_aura_julgar     | CREATE OR REPLACE FUNCTION public.cesc_aura_julgar(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_aura_julgar(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |
| cesc_aura_julgar     | CREATE OR REPLACE FUNCTION cesc.cesc_aura_julgar(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_aluno record;<br>    v_regra record;<br>    v_neg_crit int;<br>    v_neg_sec int;<br>    v_aprovado boolean;<br>    v_qtd int := 0;<br>    v_aprovados int := 0;<br>    v_reprovados int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    FOR v_aluno IN <br>        SELECT i.id as inscricao_id, i.aluno_id, i.classe_pretendida, i.curso_pretendido<br>        FROM cesc.inscricoes i<br>        WHERE i.ano_lectivo = p_ano_lectivo AND i.estado = 'matricula_paga' <br>          AND (i.tipo IS NULL OR i.tipo = 'novo')<br>    LOOP<br>        v_qtd := v_qtd + 1;<br><br>        -- Buscar a regra da classe/curso (SEM FILTRAR POR ANO)<br>        SELECT * INTO v_regra FROM cesc.regras_aura <br>        WHERE classe = v_aluno.classe_pretendida <br>          AND (curso = v_aluno.curso_pretendido OR curso IS NULL)<br>        LIMIT 1;<br><br>        IF NOT FOUND THEN<br>            UPDATE cesc.inscricoes SET tipo = 'reprovado' WHERE id = v_aluno.inscricao_id;<br>            v_reprovados := v_reprovados + 1;<br>            CONTINUE;<br>        END IF;<br><br>        -- Contar negativas, filtrando as notas pelo ano letivo<br>        SELECT count(*) INTO v_neg_crit <br>        FROM cesc.notas_trimestrais nt <br>        JOIN cesc.matriculas m ON m.id = nt.matricula_id <br>        WHERE m.aluno_id = v_aluno.aluno_id <br>          AND m.ano_lectivo = p_ano_lectivo<br>          AND nt.mfd < 10 <br>          AND nt.disciplina IN ('Matemática', 'Biologia', 'Química', 'Física');<br>        <br>        SELECT count(*) INTO v_neg_sec <br>        FROM cesc.notas_trimestrais nt <br>        JOIN cesc.matriculas m ON m.id = nt.matricula_id <br>        WHERE m.aluno_id = v_aluno.aluno_id <br>          AND m.ano_lectivo = p_ano_lectivo<br>          AND nt.mfd < 10 <br>          AND nt.disciplina NOT IN ('Matemática', 'Biologia', 'Química', 'Física');<br><br>        v_aprovado := (v_neg_crit <= v_regra.max_negativas_criticas) AND (v_neg_sec <= v_regra.max_negativas_secundarias);<br><br>        IF v_aprovado THEN<br>            UPDATE cesc.inscricoes SET tipo = 'aprovado' WHERE id = v_aluno.inscricao_id;<br>            v_aprovados := v_aprovados + 1;<br>        ELSE<br>            UPDATE cesc.inscricoes SET tipo = 'reprovado' WHERE id = v_aluno.inscricao_id;<br>            v_reprovados := v_reprovados + 1;<br>        END IF;<br>    END LOOP;<br><br>    RETURN json_build_object('ok', true, 'total', v_qtd, 'aprovados', v_aprovados, 'reprovados', v_reprovados);<br>END;<br>$function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  |
| cesc_executar_aura   | CREATE OR REPLACE FUNCTION public.cesc_executar_aura(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$ BEGIN RETURN cesc.cesc_executar_aura(p_token, p_ano_lectivo); END; $function$<br>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          |
| cesc_executar_aura   | CREATE OR REPLACE FUNCTION cesc.cesc_executar_aura(p_token character varying, p_ano_lectivo character varying)<br> RETURNS json<br> LANGUAGE plpgsql<br> SECURITY DEFINER<br>AS $function$<br>DECLARE<br>    v_user cesc.utilizadores;<br>    v_aluno record;<br>    v_regra record;<br>    v_neg_crit int;<br>    v_neg_sec int;<br>    v_aprovado boolean;<br>    v_qtd_alunos int := 0;<br>    v_qtd_aprovados int := 0;<br>    v_qtd_reprovados int := 0;<br>    <br>    v_sala record;<br>    v_inscricoes_aprovadas uuid[] := ARRAY[]::uuid[];<br>    v_idx int := 1;<br>    v_total_alunos int;<br>    v_alunos_na_sala int := 0;<br>BEGIN<br>    v_user := cesc.validar_sessao_role(p_token, ARRAY['diretor', 'sub_diretor']);<br>    IF v_user IS NULL THEN RETURN json_build_object('ok', false, 'erro', 'Não autorizado.'); END IF;<br><br>    -- 1. AVALIAÇÃO DOS ALUNOS (Aprova ou Reprovado)<br>    FOR v_aluno IN <br>        SELECT i.id as inscricao_id, i.aluno_id, i.classe_pretendida, i.curso_pretendido, i.nome_completo<br>        FROM cesc.inscricoes i<br>        WHERE i.ano_lectivo = p_ano_lectivo AND i.estado = 'matricula_paga'<br>        ORDER BY i.nome_completo ASC<br>    LOOP<br>        v_qtd_alunos := v_qtd_alunos + 1;<br><br>        SELECT * INTO v_regra FROM cesc.regras_aura <br>        WHERE ano_lectivo = p_ano_lectivo AND classe = v_aluno.classe_pretendida AND (curso = v_aluno.curso_pretendido OR curso IS NULL);<br><br>        IF NOT FOUND THEN<br>            UPDATE cesc.inscricoes SET motivo_rejeicao = 'Sem regra AURA', estado = 'aprovada' WHERE id = v_aluno.inscricao_id;<br>            v_qtd_reprovados := v_qtd_reprovados + 1;<br>            CONTINUE;<br>        END IF;<br><br>        SELECT count(*) INTO v_neg_crit FROM cesc.notas_trimestrais nt JOIN cesc.matriculas m ON m.id = nt.matricula_id WHERE m.aluno_id = v_aluno.aluno_id AND nt.mfd < 10 AND nt.disciplina IN ('Matemática', 'Biologia', 'Química', 'Física');<br>        SELECT count(*) INTO v_neg_sec FROM cesc.notas_trimestrais nt JOIN cesc.matriculas m ON m.id = nt.matricula_id WHERE m.aluno_id = v_aluno.aluno_id AND nt.mfd < 10 AND nt.disciplina NOT IN ('Matemática', 'Biologia', 'Química', 'Física');<br><br>        v_aprovado := (v_neg_crit <= v_regra.max_negativas_criticas) AND (v_neg_sec <= v_regra.max_negativas_secundarias);<br><br>        IF v_aprovado THEN<br>            v_qtd_aprovados := v_qtd_aprovados + 1;<br>            UPDATE cesc.inscricoes SET estado = 'matriculado' WHERE id = v_aluno.inscricao_id;<br>            v_inscricoes_aprovadas := array_append(v_inscricoes_aprovadas, v_aluno.inscricao_id);<br>        ELSE<br>            v_qtd_reprovados := v_qtd_reprovados + 1;<br>            UPDATE cesc.inscricoes SET motivo_rejeicao = 'Reprovado pela AURA', estado = 'aprovada' WHERE id = v_aluno.inscricao_id;<br>        END IF;<br>    END LOOP;<br><br>    -- 2. DISTRIBUIÇÃO DOS APROVADOS PELAS SALAS REAIS<br>    IF array_length(v_inscricoes_aprovadas, 1) IS NULL OR array_length(v_inscricoes_aprovadas, 1) = 0 THEN<br>        RETURN json_build_object('ok', true, 'total_processados', v_qtd_alunos, 'aprovados', v_qtd_aprovados, 'reprovados', v_qtd_reprovados, 'mensagem', 'Nenhum aluno aprovado para distribuir.');<br>    END IF;<br><br>    v_total_alunos := array_length(v_inscricoes_aprovadas, 1);<br>    v_alunos_na_sala := 0;<br>    v_idx := 1;<br><br>    FOR v_sala IN <br>        SELECT id, nome_sala, pavilhao, turno, capacidade FROM cesc.salas ORDER BY turno, pavilhao, nome_sala<br>    LOOP<br>        WHILE v_idx <= v_total_alunos AND v_alunos_na_sala < v_sala.capacidade LOOP<br>            UPDATE cesc.matriculas <br>            SET sala_id = v_sala.id <br>            WHERE aluno_id = (SELECT aluno_id FROM cesc.inscricoes WHERE id = v_inscricoes_aprovadas[v_idx])<br>              AND ano_lectivo = p_ano_lectivo;<br><br>            v_idx := v_idx + 1;<br>            v_alunos_na_sala := v_alunos_na_sala + 1;<br>        END LOOP;<br><br>        IF v_idx > v_total_alunos THEN EXIT; END IF;<br>        v_alunos_na_sala := 0;<br>    END LOOP;<br><br>    RETURN json_build_object(<br>        'ok', true, <br>        'total_processados', v_qtd_alunos,<br>        'aprovados', v_qtd_aprovados,<br>        'reprovados', v_qtd_reprovados,<br>        'mensagem', 'Distribuição concluída com sucesso.'<br>    );<br>END;<br>$function$<br> |
